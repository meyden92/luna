# =============================================================================
# LUNASHARE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

NODE_ENV=development

# =============================================================================
# AUTHENTICATION (Runtime Only)
# =============================================================================
# Better Auth configuration for user authentication and session management
# Generate secret: openssl rand -base64 32

# Secret key for signing JWTs and securing sessions (REQUIRED)
BETTER_AUTH_SECRET=your-random-secret-key-here-min-32-characters

# Base URL where your app is hosted (REQUIRED)
# Local: http://localhost:3000
# Production: https://yourdomain.com
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth (optional - remove if not using Discord login)
# Get these from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# =============================================================================
# CLOUD STORAGE - AWS S3 / Cloudflare R2 (Runtime Only)
# =============================================================================
# Used for file uploads and CDN delivery

# S3-compatible access credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Bucket configuration
AWS_BUCKET_NAME=your-bucket-name
AWS_REGION=auto

# S3 endpoint (use Cloudflare R2, AWS S3, or compatible service)
# Cloudflare R2: https://account-id.eu.r2.cloudflarestorage.com
# AWS S3: https://s3.region.amazonaws.com
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# =============================================================================
# DATABASE (Runtime Only)
# =============================================================================
# MySQL/MariaDB connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://username:password@localhost:3306/lunashare

# =============================================================================
# NEXT.JS PUBLIC VARIABLES (Build Time + Runtime)
# =============================================================================
# These are embedded into the JavaScript bundle during build
# They are visible to the client browser

# CDN URL for serving uploaded files
NEXT_PUBLIC_CDN_URL=https://deliver.yourdomain.com

# Server URL for API calls and redirects
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# =============================================================================
# EXTERNAL APIS (Runtime Only)
# =============================================================================

# Replicate API for AI image generation (optional)
# Get token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-replicate-api-token-here

# =============================================================================
# FORM SHARE ENCRYPTION (Runtime Only)
# =============================================================================
# AES-256-GCM key for encrypting sensitive form fields
# Generate: openssl rand -base64 32
FORM_FIELD_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here
