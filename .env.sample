# =============================================================================
# LUNASHARE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
#
# Only what the app needs before it can reach its database lives here.
# Everything else (S3 connection, CDN URL, fal keys, signing secrets, proxy
# settings) is set in the admin area under Settings -> Vault. Any Vault entry
# may also be set here under the same name; the environment then wins.

NODE_ENV=development

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://lunashare:lunashare@127.0.0.1:5432/lunashare

# Master key: encrypts the Vault and sensitive form fields, and derives the
# signing keys. Back it up outside the server: without it the Vault cannot be
# decrypted and every Vault entry has to be set again.
# Generate: openssl rand -base64 32
FORM_FIELD_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# Better Auth: signs sessions. Changing it signs every User out.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret-key-here-min-32-characters

# Base URL where the app is hosted.
# Local: http://localhost:3000   Production: https://yourdomain.com
BETTER_AUTH_URL=http://localhost:3000

# Absolute origin of the app. Leave unset unless the auth API is served from a
# different origin than the app itself; empty means "same origin".
PUBLIC_BASE_URL=
