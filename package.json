{
  "name": "lunashare",
  "version": "4.7.2",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "dev": "vite dev",
    "build": "NODE_ENV=production vite build",
    "start": "bun .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:audit-coverage": "bun scripts/db/audit-coverage.ts",
    "auth:set-credentials": "bun scripts/auth/set-credentials.ts",
    "lint": "biome lint --diagnostic-level=warn",
    "format": "biome check --write",
    "update": "bunx taze major --interactive --install",
    "check-types": "bun run generate:routes && bun run check:css-types && tsc --noEmit --pretty",
    "check:css-types": "tcm src -p '**/*.module.css' --listDifferent",
    "generate:css-types": "tcm src -p '**/*.module.css' -s",
    "check-all": "bun run format && bun run lint && bun run check-types",
    "generate:routes": "tsr generate",
    "test": "bun test",
    "test:e2e": "bun --no-env-file scripts/e2e/run.ts",
    "screenshots": "bun --no-env-file scripts/screenshots/capture.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/lib-storage": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/core": "1.7.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-virtual": "3.14.25",
    "better-auth": "1.7.15",
    "clsx": "^2.1.1",
    "cron-schedule": "^6.0.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "highlight.js": "11.12.0",
    "lucide-react": "1.67.0",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-h5-audio-player": "^3.10.2",
    "replicate": "^1.4.0",
    "sharp": "^0.35.5",
    "sonner": "2.0.8",
    "wavesurfer.js": "^8.0.5",
    "zod": "^4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@tanstack/router-cli": "1.167.46",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "nitro": "3.0.261102-rc",
    "typed-css-modules": "0.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "8.3.5"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "author": "meyden92 (https://github.com/meyden92)",
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "sharp"
  ]
}
