{
  "name": "lunashare",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "dev": "vite dev",
    "build": "NODE_ENV=production vite build",
    "start": "bun .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:verify": "bun scripts/db/verify-schema.ts",
    "db:verify-data": "bun scripts/db/verify-data.ts",
    "db:audit-coverage": "bun scripts/db/audit-coverage.ts",
    "db:rehearse": "bun run db:push && bun scripts/db/transform.ts && bun run db:verify && bun run db:verify-data",
    "lint": "biome lint --diagnostic-level=warn",
    "format": "biome check --write",
    "update": "bunx taze major --interactive --install",
    "check-types": "bun run generate:routes && tsc --noEmit --pretty",
    "check-all": "bun run format && bun run lint && bun run check-types",
    "generate:routes": "tsr generate",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/lib-storage": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1080.0",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@nivo/bar": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.27",
    "@tanstack/react-virtual": "^3.14.5",
    "@tanstack/zod-adapter": "^1.167.0",
    "@xyflow/react": "^12.11.2",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-schedule": "^6.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "h3-v2": "npm:h3@2.0.1-rc.23",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-h5-audio-player": "^3.10.2",
    "replicate": "^1.4.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "wavesurfer.js": "^7.12.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/router-cli": "^1.167.18",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.1.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "mariadb": "^3.5.3",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.1.3"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "author": "meyden92 (https://github.com/meyden92)",
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "sharp"
  ]
}
