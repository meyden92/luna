{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "esnext",
    "outDir": "out",
    "sourceMap": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "removeComments": true,
    "preserveConstEnums": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    /* Strictness */
    "strict": true,
    "alwaysStrict": true,
    "strictNullChecks": true,
    "checkJs": true,
    "noImplicitOverride": true,
    // "exactOptionalPropertyTypes": true,
    /* Linting */
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "verbatimModuleSyntax": true,
    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ESNext"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    // Deliberately not incremental: a stale .tsbuildinfo made `check-types`
    // pass locally while CI failed on the same commit (better-auth 1.7 bump).
    // A full check takes seconds here; correctness beats the cache.
    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@/public/*": ["./public/*"],
      "@/components/*": ["./src/components/*"]
    }
  },
  "typeRoots": ["./node_modules/@types", "./src/types"],
  "include": ["**/*.ts", "**/*.tsx", "./types/**/*.d.ts", "vite.config.ts", "playwright.config.ts", "tests/**/*.ts"],
  "exclude": [
    "./out/**/*",
    "./node_modules/**/*",
    "./.output/**/*",
    "./.storybook/**/*",
    ".claude/**/*",
    "./test-results/**/*",
    "./playwright-report/**/*"
  ]
}
